# LLM 配置模板：复制成 .env 后填上真实 Key 即可（cp env.example .env）
# 不填也能玩：AI 会自动走确定性兜底，不会卡局。

# OpenAI 兼容接口的 Key
LLM_API_KEY=

# 接口地址（OpenAI 官方 / 任何兼容网关 / 本地反代）
LLM_BASE_URL=https://api.openai.com/v1

# 模型名：便宜档优先，例如 gpt-4o-mini / qwen-turbo / glm-4-flash
LLM_MODEL=gpt-4o-mini

# 打开调试口 /debug/ai（含 AI 的 Prompt 与决策留痕，仅供本地排查与自动化测试）
# AI_DEBUG=1

# 或者用 config/llm.json（脚本化配置，字段同样四个）：
#   {"apiKey": "...", "baseUrl": "...", "model": "...", "fallbacks": ["..."]}
